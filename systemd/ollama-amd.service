[Unit]
Description=Ollama on the AMD Radeon (Vulkan) — ocode autocomplete
After=network.target

[Service]
ExecStart=/usr/bin/ollama serve
Environment=OLLAMA_HOST=127.0.0.1:11435
Environment=OLLAMA_MODELS=%h/.local/share/ollama-amd/models
Environment=OLLAMA_VULKAN=1
Environment=OLLAMA_KEEP_ALIVE=24h
Environment=OLLAMA_NUM_PARALLEL=1
# Only expose the Radeon to this instance; the RTX stays with the main Ollama service.
Environment=CUDA_VISIBLE_DEVICES=-1
Environment=VK_DRIVER_FILES=/usr/share/vulkan/icd.d/radeon_icd.json
Environment=VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/radeon_icd.json
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
